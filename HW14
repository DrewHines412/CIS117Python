import string
import re
import requests
from html.parser import HTMLParser
from tkinter import *

class MyHTMLParser(HTMLParser):
  """ Subclass of HTMLParser that extracts clean data from HTML, tracks word
  frequency, and dumps text to a file"""

  def __init__(self):
      """ Initialize parser and creates an empty list to store data"""

      HTMLParser.__init__(self)
      self.emails = []


  def handle_data(self, data):
      """ Handle the text data and collect emails"""

      words = data.split()
      email_pattern = r'[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
      '''looks for email regular expression'''

      for word in words:
        match = re.search(email_pattern, word)
        if match:
          email = match.group().lower()
          self.emails.append(email)

  def collect_emails(self):
    '''Return the list of collected emails'''
    return self.emails

def click():
  entered_text = textentry.get()

  try:
    response = requests.get(entered_text)
    html = response.text

    parser = MyHTMLParser()
    parser.feed(html)
    emails = parser.collect_emails()

    if emails:
      result_label.config(text = '\n'.join(emails))
    else:
      result_label.config(text = "No Emails Found")
  except:
      result_label.config(text = "Error Fetching Page")

window = TK()
window.title("Search For Emails")
window.configure(background = "blue")

Label (window, text = "Enter URL to Search for Emails", bg = "black", fg = "white", font = "none 12 bold").grid(row = 1, column = 0, sticky = W)

textentry = Entry(window, width = 20, bg = "white")
textentry.grid(row = 2, column = 0, sticky = W)

Button (window, text = "SUBMIT", width = 6, command = click) .grid(row = 3, column = 0, sticky = W)
